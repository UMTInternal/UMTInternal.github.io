# ==========================================
#   CHARZEE - PERFORMANCE
#   Compression + browser caching (Apache)
# ==========================================

# ---- Gzip text files (HTML components, CSS, JS, SVG, JSON) ----
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml font/ttf font/otf
</IfModule>

# ---- Make sure WebP is served with the right type ----
<IfModule mod_mime.c>
    AddType image/webp .webp
</IfModule>

# ---- Browser caching ----
# Images and fonts rarely change: cache for 30 days.
# HTML, CSS and JS change often while the site is being edited: the browser
# keeps a copy but checks with the server each time (fast 304 if unchanged),
# so edits show up on a normal refresh.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 hour"

    ExpiresByType image/webp                "access plus 30 days"
    ExpiresByType image/png                 "access plus 30 days"
    ExpiresByType image/jpeg                "access plus 30 days"
    ExpiresByType image/gif                 "access plus 30 days"
    ExpiresByType image/svg+xml             "access plus 30 days"
    ExpiresByType image/x-icon              "access plus 30 days"
    ExpiresByType video/mp4                 "access plus 30 days"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"

    ExpiresByType text/html                 "access plus 0 seconds"
    ExpiresByType text/css                  "access plus 0 seconds"
    ExpiresByType application/javascript    "access plus 0 seconds"
    ExpiresByType text/javascript           "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html|css|js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # While images are still being replaced under the same file names, the
    # browser re-checks them on every visit (a quick "304 Not Modified" when
    # unchanged). Before going live, change "no-cache" to
    # "public, max-age=2592000" (30 days) for faster repeat visits.
    <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|mp4)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(woff2?)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    Header unset Pragma
</IfModule>
